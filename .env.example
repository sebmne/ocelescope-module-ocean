# Backend configuration. Copy to `.env`; all values are optional.
FRONTEND_URL="http://localhost:3000"
SESSION_ID_HEADER="ocelescope-session-id"
MODE="development"
EXPOSE_ERROR_DETAILS=false
# DATA_DIR="data"
# PLUGIN_DIR="plugins"

# The factor catalog consulted for emission factors is Climatiq. Users connect
# it in the app with their own API key, which is kept in DATA_DIR/socel (or
# ~/.ocelescope/socel). A key set here comes first and cannot be changed there.
# CLIMATIQ_API_KEY=""
# A fixed Climatiq data release ("38"), or the latest within one ("^38");
# without it the latest release is followed.
# CLIMATIQ_DATA_VERSION=""
