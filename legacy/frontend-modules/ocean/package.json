    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@mantine/core": "catalog:",
    "@ocelescope/api-base": "catalog:",
    "@ocelescope/api-client": "catalog:",
    "@ocelescope/api-config": "catalog:",
    "@ocelescope/core": "catalog:",
    "@r4pm/components": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "axios": "catalog:",
    "dependency-cruiser": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "orval": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
