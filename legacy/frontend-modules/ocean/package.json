{
  "name": "@instance/ocean-module",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:api": "uv run ocelescope-backend openapi --module ocean",
    "build": "pnpm run generate:api && orval && tsdown",
